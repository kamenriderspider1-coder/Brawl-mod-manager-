{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brawl Cloud catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "character",
              "stage",
              "music",
              "ui",
              "mod-pack",
              "other"
            ]
          },
          "creator": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "compatibility": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "Repository-relative path to a permitted file, e.g. cloud-library/files/example.zip"
          },
          "download": {
            "type": "string",
            "format": "uri"
          },
          "source": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "file"
            ]
          },
          {
            "required": [
              "download"
            ]
          },
          {
            "required": [
              "source"
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
