{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brawl Cloud Google Drive catalog",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "fileId", "size", "uploadedAt"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["character", "stage", "music", "ui", "mod-pack", "other"] },
          "creator": { "type": "string" },
          "summary": { "type": "string" },
          "compatibility": { "type": "string" },
          "fileId": { "type": "string", "description": "Google Drive file ID in the user's Brawl Cloud folder" },
          "download": { "type": "string", "format": "uri" },
          "source": { "type": "string", "format": "uri" },
          "size": { "type": "integer", "minimum": 0 },
          "uploadedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false,
        "anyOf": [
          { "required": ["fileId"] },
          { "required": ["download"] },
          { "required": ["source"] }
        ]
      }
    }
  },
  "additionalProperties": false
}
